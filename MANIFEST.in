recursive-include src/qwarp/assets *.svg *.ts *.qm
include CONTRIBUTING.md
recursive-include docs/legal *.md *.tsv
recursive-include requirements *.txt *.md
recursive-include scripts *.py *.sh
recursive-include packaging/debian *
recursive-include packaging/rpm *.spec
include docs/DEVELOPMENT.md docs/RELEASING.md qwarp.desktop

prune .agents
prune .codex
prune .claude
prune .cursor
prune .windsurf
prune .continue
prune .gemini
prune .cline
prune .roo
prune .github/instructions
prune .github/prompts
global-exclude AGENTS.md AGENTS.override.md CLAUDE.md CLAUDE.local.md GEMINI.md .cursorrules .windsurfrules .clinerules .roorules .aider* .mcp.json mcp.json skills-lock.json
exclude .github/copilot-instructions.md
